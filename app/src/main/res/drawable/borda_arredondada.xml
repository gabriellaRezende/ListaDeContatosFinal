<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Cor de fundo do elemento -->
    <solid android:color="#FFFFFF"/> <!-- Altere para a cor desejada -->

    <!-- Arredondamento dos cantos -->
    <corners android:radius="8dp"/> <!-- Define o raio dos cantos -->

    <!-- Borda ao redor do elemento -->
    <stroke
        android:width="1dp"
        android:color="@color/blueGrey_100"/> <!-- Altere a cor da borda conforme necessário -->

</shape>
